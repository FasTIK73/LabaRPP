{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/rpp-.log",
          "rollingInterval": "Day"
        }
      }
    ]
  },
  "SalarySettings": {
    "ExtraSaleSum": 10000,
    "MaxParallelThreads": 4
  },
  "AllowedHosts": "*"
}